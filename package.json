{
  "name": "agito019",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm run --parallel dev:web dev:api",
    "dev:web": "pnpm --filter @agito019/web dev",
    "dev:api": "pnpm --filter @agito019/api start:dev",
    "build": "pnpm --filter @agito019/shared build && pnpm --filter @agito019/api build && pnpm --filter @agito019/web build",
    "lint": "pnpm --filter @agito019/api lint && pnpm --filter @agito019/web lint",
    "typecheck": "pnpm --filter @agito019/shared typecheck && pnpm --filter @agito019/api typecheck && pnpm --filter @agito019/web typecheck",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "test": "pnpm --filter @agito019/api test",
    "deploy:vps": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-vps.ps1"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.43.1",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
